{
  "name": "qq-ai",
  "private": true,
  "version": "0.2.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "npm run prepare:quantum-assets && npm run test:game-ai && npm run test:online-core && tsc -b && vite build",
    "preview": "vite preview",
    "typecheck": "tsc -b",
    "test:game-ai": "node --experimental-strip-types --test tests/qqcross-ai.test.mjs",
    "test:online-core": "node --experimental-strip-types --test tests/online-core.test.mjs tests/qq-ai-core.test.mjs tests/benchmark-schema.test.mjs tests/qq-quantum-browser.test.mjs",
    "prepare:quantum-assets": "node scripts/fetch_qq_quantum_model.mjs"
  },
  "dependencies": {
    "@mlc-ai/web-llm": "0.2.88",
    "@supabase/supabase-js": "2.57.4",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "katex": "0.19.1",
    "react-markdown": "10.1.0",
    "rehype-katex": "7.0.1",
    "remark-gfm": "4.0.1",
    "remark-math": "6.0.0",
    "@huggingface/transformers": "4.3.2"
  },
  "devDependencies": {
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "5.2.0",
    "typescript": "7.0.2",
    "vite": "6.4.6"
  },
  "overrides": {
    "katex": "$katex"
  }
}
